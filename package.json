{
  "name": "monitor-bot-a",
  "version": "1.0.0",
  "description": "Monitoring web server and Telegram alert bot (Bot A)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "test": "node test-server.js",
    "test:ping": "node test-ping.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:create": "wrangler d1 create monitor-db",
    "db:migrate:local": "wrangler d1 execute monitor-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute monitor-db --remote --file=schema.sql",
    "bot:setup": "node scripts/setup-bot-profile.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "monitoring",
    "healthcheck",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "wrangler": "^4.133.0"
  }
}
