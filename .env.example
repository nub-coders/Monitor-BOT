# ==========================================
# Telegram Bot & Alert Configuration
# ==========================================
# Your Telegram bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Your personal or channel/group Chat ID where alerts will be delivered
# (Obtain this by messaging @userinfobot or checking bot updates)
MY_CHAT_ID=123456789

# ==========================================
# Authentication & Server Configuration
# ==========================================
# Shared secret token expected in the JSON body of POST /ping requests
SECRET_TOKEN=change-this-to-a-secure-random-secret-token

# Port for the Express monitoring server (defaults to 3000)
PORT=3000

# ==========================================
# Monitoring Thresholds & Expected Bots
# ==========================================
# Pre-registered bots to monitor from startup (comma-separated).
# Any bot that pings will also be dynamically added.
EXPECTED_BOTS=Bot B,Bot C,Bot D

# How frequently the background health check runs in milliseconds (Default: 1 minute)
CHECK_INTERVAL_MS=60000

# How long before a bot is flagged as unresponsive in milliseconds (Default: 10 minutes)
TIMEOUT_THRESHOLD_MS=600000

# Send a Telegram alert when a bot recovers after an outage? (true / false)
ENABLE_RECOVERY_ALERTS=true
